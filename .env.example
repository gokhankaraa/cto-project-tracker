# docker-compose.yml icin ornek degerler. Kopyalayip duzenleyin: cp .env.example .env
# .env git'e eklenmez; buradaki degerler yalnizca yerel gelistirme icindir.
DB_NAME=ctotracker
DB_USER=ctotracker
DB_PASSWORD=ctotracker_dev
DB_PORT=5433
# docker compose up ile acilan portlar: backend (API, Swagger) ve frontend
APP_PORT=8080
WEB_PORT=3000
# Ayri calisan frontend adresi/adresleri (virgulle ayrilmis; npm run dev = 5173); API bu adreslerden gelen
# tarayici isteklerini kabul eder. Docker'daki frontend (WEB_PORT) API'ye kendi adresinden ulastigi icin gerekmez.
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Giris token'larini imzalayan sir; en az 32 bayt. Gercek ortamda rastgele uretin: openssl rand -base64 48
JWT_SECRET=dev-only-jwt-secret-do-not-use-in-production-0123456789
