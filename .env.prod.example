# docker-compose.prod.yml icin degerler. Kopyalayip doldurun: cp .env.prod.example .env.prod
# .env.prod git'e eklenmez. Bos birakilan zorunlu deger kurulumu durdurur.

# Zorunlu: veritabani parolasi. Uretin: openssl rand -base64 24
DB_PASSWORD=
# Zorunlu: giris token'larini imzalayan sir, en az 32 bayt. Uretin: openssl rand -base64 48
# Degisirse herkes yeniden giris yapar.
JWT_SECRET=

# Ilk admin: yalnizca veritabaninda hic kullanici yokken (ilk acilista) okunur. Parola en az 12 karakter.
# Ilk acilistan sonra ADMIN_PASSWORD'u silebilirsiniz; yeniden baslatmak admin'i degistirmez.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Sistem Yöneticisi

# Istege bagli
DB_NAME=ctotracker
DB_USER=ctotracker
# Uygulamanin acildigi port (http://sunucu:WEB_PORT)
WEB_PORT=80
# Giris token'inin gecerlilik suresi
JWT_TOKEN_TTL=8h
